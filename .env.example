DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOW_REGISTRATION=true
DB_ENGINE=sqlite

# MySQL 配置：DB_ENGINE=mysql 时启用
DB_NAME=testchain
DB_USER=testchain
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Docker 部署前请生成独立随机密码与 SECRET_KEY，外网部署时启用 HTTPS。
MYSQL_ROOT_PASSWORD=
SECURE_SSL_REDIRECT=false
COOKIE_SECURE=false
TRUST_PROXY=false
